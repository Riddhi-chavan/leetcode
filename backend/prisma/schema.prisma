generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id    String @id @default(cuid())
  title String
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      UserRole @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── new profile fields ──
  avatar   String? // URL string
  bio      String?
  github   String?
  linkedin String?
  website  String?

  problems    Problem[]
  submissions Submission[]
  roleRequest RoleRequest?

  @@index([role])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  language    String
  sourceCode  String
  status      String
  passedCount Int
  totalCount  Int
  runtime     String?
  memory      String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@index([userId, problemId])
}

model Problem {
  id                 String     @id @default(cuid())
  title              String
  description        String
  difficulty         Difficulty
  tags               String[]
  examples           Json
  constraints        String
  hints              String?
  editorial          String?
  testCases          Json
  codeSnippets       Json
  referenceSolutions Json
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  submissions Submission[]
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([difficulty])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoleRequest {
  id        String        @id @default(cuid())
  userId    String        @unique
  reason    String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
