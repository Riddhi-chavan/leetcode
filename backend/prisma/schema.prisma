// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id    String @id @default(cuid())
  title String
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      UserRole @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems Problem[]
  submissions Submission[]


  @@index([role])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Submission {
  id         String   @id @default(cuid())
  userId     String
  problemId  String
  language   String
  sourceCode String
  status     String   // ACCEPTED or WRONG_ANSWER
  passedCount Int
  totalCount  Int
  runtime    String?
  memory     String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@index([userId, problemId])
}


model Problem {
  id  String @id @default(cuid())
  title String
  description String
  difficulty  Difficulty 
  tags   String[]
  examples Json
  constraints String

  hints String?
  editorial String?

  testCases  Json
  codeSnippets Json  //Language-specific starter code snippets
  referenceSolutions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions Submission[]

  userId   String
  user   User  @relation(fields: [userId] , references: [id] , onDelete: Cascade)

  @@index([difficulty])
}

